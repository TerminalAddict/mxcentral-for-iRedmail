# Development/test defaults only. Production deployments must start from
# .env.production.example and pass `php artisan mxcentral:check-production`.
APP_NAME="mxcentral-for-iRedmail"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# For subdirectory deployments, include the path, for example:
# APP_URL=https://domain.example/mxcentral
APP_URL=http://localhost
MXCENTRAL_PRIVILEGED_HELPER_COMMAND="/usr/bin/sudo /usr/local/sbin/mxcentral-privileged"
MXCENTRAL_PRIVILEGED_HELPER_TIMEOUT=60
MXCENTRAL_LOGIN_RATE_CACHE_STORE=file
MXCENTRAL_LOGIN_RATE_WINDOW=3600
MXCENTRAL_LOGIN_ACCOUNT_LOCK_THRESHOLD=5
MXCENTRAL_LOGIN_IP_LOCK_THRESHOLD=10
MXCENTRAL_LOGIN_LOCK_SECONDS=60
MXCENTRAL_LOGIN_MAX_LOCK_SECONDS=900
MXCENTRAL_PASSWORD_REVEAL_ADMINS=
MXCENTRAL_PASSWORD_REVEAL_REQUIRE_TOTP=true
MXCENTRAL_PASSWORD_REVEAL_TOTP_SECRETS="{}"
MXCENTRAL_PASSWORD_REVEAL_CACHE_STORE=file
MXCENTRAL_PASSWORD_REVEAL_TOKEN_SECONDS=60
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_COOKIE=mxcentral_for_iredmail_session
CACHE_STORE=array
QUEUE_CONNECTION=sync

IREDMAIL_DB_HOST=127.0.0.1
IREDMAIL_DB_PORT=3306

VMAIL_DB_DRIVER=mysql
VMAIL_DB_DATABASE=vmail
VMAIL_DB_USERNAME=mxcentral_vmail
VMAIL_DB_PASSWORD=

IREDADMIN_DB_DRIVER=mysql
IREDADMIN_DB_DATABASE=iredadmin
IREDADMIN_DB_USERNAME=mxcentral_iredadmin
IREDADMIN_DB_PASSWORD=

AMAVISD_DB_DRIVER=mysql
AMAVISD_DB_DATABASE=amavisd
AMAVISD_DB_USERNAME=mxcentral_amavisd
AMAVISD_DB_PASSWORD=
AMAVISD_QUARANTINE_HOST=127.0.0.1
AMAVISD_QUARANTINE_PORT=9998
QUARANTINE_NOTIFICATION_STATE_PATH=
QUARANTINE_NOTIFICATION_SUBJECT="[Attention] You have %(total)d quarantined email(s)"
QUARANTINE_NOTIFICATION_MAX_ROWS=50
IREDMAIL_DECRYPTABLE_PASSWORD_COLUMN=decrypt-pass
IREDMAIL_UPGRADE_CHECK_STATE_PATH=
IREDMAIL_UPGRADE_CHECK_TIMEOUT=15
IREDMAIL_UPGRADE_NOTIFICATION_SUBJECT="[Attention] iRedMail upgrade available"
IREDMAIL_RELEASE_PATH=/etc/iredmail-release
IREDAPD_VERSION_FILE=/opt/iredapd/libs/__init__.py
IREDMAIL_UPGRADE_DOCS_BASE_URL=https://docs.iredmail.org
IREDMAIL_UPGRADE_RELEASES_URL=https://docs.iredmail.org/iredmail.releases.html
IREDMAIL_UPGRADE_DOWNLOAD_URL=https://www.iredmail.org/download.html
IREDAPD_TAGS_URL=https://github.com/iredmail/iRedAPD/tags
IREDAPD_TAGS_API_URL=https://api.github.com/repos/iredmail/iRedAPD/tags
AMAVISD_CONFIG_PATH=/etc/amavis/conf.d/50-user
AMAVISD_DKIM_DIRECTORY=/var/lib/dkim
AMAVISD_DKIM_SELECTOR=mxcentral
AMAVISD_DKIM_BITS=1024

IREDAPD_DB_DRIVER=mysql
IREDAPD_DB_DATABASE=iredapd
IREDAPD_DB_USERNAME=mxcentral_iredapd
IREDAPD_DB_PASSWORD=

FAIL2BAN_DB_DRIVER=mysql
FAIL2BAN_DB_DATABASE=fail2ban
FAIL2BAN_DB_USERNAME=mxcentral_fail2ban
FAIL2BAN_DB_PASSWORD=
IREDAPD_SETTINGS_PATH=/opt/iredapd/settings.py
POSTFIX_MAIN_CF_PATH=/etc/postfix/main.cf
POSTFIX_SENDER_ACCESS_PATH=/etc/postfix/sender_access.pcre
POSTFIX_DISCARD_RECIPIENTS_PATH=/etc/postfix/discard_recipients
POSTFIX_STAGING_DOMAINS_PATH=/etc/postfix/mxcentral_staging_domains.pcre
SOGO_ROOT_TEMPLATE_SOURCE=
SOGO_ROOT_TEMPLATE_TARGET=/var/lib/sogo/GNUstep/Library/SOGo/Templates/MainUI/SOGoRootPage.wox

IREDMAIL_STORAGE_BASE_DIRECTORY=/var/vmail/vmail1
IREDMAIL_STORAGE_NODE=vmail1
IREDMAIL_MAILBOX_DIRECTORY_TEMPLATE="{domain}/{local}/"
IREDMAIL_MAILBOX_LANGUAGE=en_US
IREDMAIL_BACKUP_MX_PORT=25
IREDMAIL_MAILING_LIST_TRANSPORT_TEMPLATE="mlmmj:{address}"
IREDMAIL_DEFAULT_MTA_TRANSPORT=dovecot
IREDMAIL_PAGE_SIZE=50
IREDMAIL_WEBMAIL_URL=/SOGo/
IREDMAIL_SPF_SERVER_HOSTNAME=
IREDMAIL_SPF_SERVER_IPS=
IREDMAIL_DNS_CACHE_STORE=file
MLMMJADMIN_URL=
MLMMJADMIN_TOKEN=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# For subdirectory deployments, set this to the app path, for example /mxcentral.
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
