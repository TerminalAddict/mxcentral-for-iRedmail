#!/usr/bin/python3
"""Root-side privileged operation broker for MXCentral.

The web application invokes this program with no command-line arguments and
sends one JSON request on stdin. All paths and executable commands come from a
root-owned configuration file, never from the request.
"""

import ast
import fcntl
import grp
import html
import json
import os
import pwd
import re
import secrets
import stat
import subprocess
import sys
import time
import urllib.parse
import xml.etree.ElementTree as ET
from pathlib import Path

CONFIG_PATH = "/etc/mxcentral/privileged-helper.json"
LOCK_PATH = "/run/lock/mxcentral-privileged.lock"
MAX_REQUEST_BYTES = 8 * 1024 * 1024
MAX_FILE_BYTES = 4 * 1024 * 1024
SAFE_COMMAND_ENV = {
    "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
    "LANG": "C",
    "LC_ALL": "C",
}
DOMAIN_PATTERN = re.compile(
    r"(?=.{1,253}\Z)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+"
    r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\Z"
)
EMAIL_PATTERN = re.compile(r"^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@" + DOMAIN_PATTERN.pattern[:-2] + r"$")

DEFAULT_CONFIG = {
    "files": {
        "amavis_config": "/etc/amavis/conf.d/50-user",
        "iredapd_settings": "/opt/iredapd/settings.py",
        "postfix_main": "/etc/postfix/main.cf",
        "postfix_sender_access": "/etc/postfix/sender_access.pcre",
        "postfix_discard_recipients": "/etc/postfix/discard_recipients",
        "postfix_staging_domains": "/etc/postfix/mxcentral_staging_domains.pcre",
        "sogo_template": "/var/lib/sogo/GNUstep/Library/SOGo/Templates/MainUI/SOGoRootPage.wox",
    },
    "file_defaults": {
        "amavis_config": {"owner": "root", "group": "amavis", "mode": "0640"},
        "iredapd_settings": {"owner": "root", "group": "iredapd", "mode": "0640"},
        "postfix_main": {"owner": "root", "group": "root", "mode": "0644"},
        "postfix_sender_access": {"owner": "root", "group": "postfix", "mode": "0640"},
        "postfix_discard_recipients": {"owner": "root", "group": "postfix", "mode": "0640"},
        "postfix_staging_domains": {"owner": "root", "group": "postfix", "mode": "0640"},
        "sogo_template": {"owner": "root", "group": "sogo", "mode": "0644"},
    },
    "file_sources": {
        "sogo_template": "/usr/lib/GNUstep/SOGo/Templates/MainUI/SOGoRootPage.wox",
    },
    "dkim": {
        "directory": "/var/lib/dkim",
        "selector": "mxcentral",
        "owner": "amavis",
        "group": "amavis",
        "mode": "0400",
        "genrsa": ["/usr/sbin/amavisd", "genrsa"],
    },
    "commands": {
        "amavis_showkeys": ["/usr/sbin/amavisd", "showkeys"],
        "amavis_testkeys": ["/usr/sbin/amavisd", "testkeys"],
        "amavis_restart": ["/usr/bin/systemctl", "restart", "amavis.service"],
        "iredapd_restart": ["/usr/bin/systemctl", "restart", "iredapd.service"],
        "postfix_reload": ["/usr/bin/systemctl", "reload", "postfix.service"],
        "postfix_check": ["/usr/sbin/postfix", "check"],
        "sogo_reload": ["/usr/bin/systemctl", "restart", "sogo.service"],
        "postmap": ["/usr/sbin/postmap"],
        "fail2ban_unban": ["/usr/bin/fail2ban-client", "unban"],
    },
    "operation_state_directory": "/var/lib/mxcentral/operations",
    "web_users": ["www-data"],
}
ACTIVE_CONFIG = DEFAULT_CONFIG


class RequestError(Exception):
    pass


def secure_regular_file(path: str, *, required: bool = True) -> os.stat_result | None:
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        if required:
            raise RequestError(f"Required file does not exist: {path}")
        return None
    if not stat.S_ISREG(info.st_mode):
        raise RequestError(f"Refusing non-regular file: {path}")
    if info.st_nlink != 1:
        raise RequestError(f"Refusing multiply-linked file: {path}")
    return info


def validate_directory_path(path: str, *, allow_root_symlinks: bool) -> None:
    current = "/"
    for component in Path(path).parts[1:]:
        current = os.path.join(current, component)
        info = os.lstat(current)
        if stat.S_ISLNK(info.st_mode):
            if not allow_root_symlinks or info.st_uid != 0:
                raise RequestError(f"Refusing unsafe directory symlink: {current}")
            continue
        if not stat.S_ISDIR(info.st_mode):
            raise RequestError(f"Refusing unsafe directory component: {current}")
        if info.st_mode & 0o022:
            raise RequestError(f"Directory must not be group/other writable: {current}")
        web_uids = set()
        for user in ACTIVE_CONFIG.get("web_users", ["www-data"]):
            try:
                web_uids.add(pwd.getpwnam(str(user)).pw_uid)
            except KeyError as error:
                raise RequestError(f"Configured web user does not exist: {user}") from error
        if info.st_uid in web_uids:
            raise RequestError(f"Directory must not be owned by the web worker: {current}")


def secure_directory(path: str) -> int:
    if not os.path.isabs(path):
        raise RequestError("Configured paths must be absolute.")
    if ".." in Path(path).parts:
        raise RequestError("Configured paths must not contain traversal.")

    # iRedMail exposes versioned package directories through aliases such as
    # /opt/iredapd -> /opt/iRedAPD-6.1. Only root-owned aliases in already
    # protected parents are accepted. The canonical target is then validated
    # independently and opened without following a final symlink.
    validate_directory_path(path, allow_root_symlinks=True)
    resolved = os.path.realpath(path)
    validate_directory_path(resolved, allow_root_symlinks=False)

    return os.open(resolved, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)


def read_secure_config() -> dict:
    if not os.path.exists(CONFIG_PATH):
        return DEFAULT_CONFIG
    info = secure_regular_file(CONFIG_PATH)
    if info is None or info.st_uid != 0 or info.st_mode & 0o022:
        raise RequestError(f"{CONFIG_PATH} must be root-owned and not group/other writable.")
    descriptor = os.open(CONFIG_PATH, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        with os.fdopen(descriptor, "r", encoding="utf-8") as handle:
            configured = json.load(handle)
    except Exception as error:
        raise RequestError(f"Cannot read {CONFIG_PATH}: {error}") from error

    merged = json.loads(json.dumps(DEFAULT_CONFIG))
    for section, value in configured.items():
        if isinstance(value, dict) and isinstance(merged.get(section), dict):
            merged[section].update(value)
        else:
            merged[section] = value
    return merged


def identity(name: str, group: bool = False) -> int:
    try:
        return grp.getgrnam(name).gr_gid if group else pwd.getpwnam(name).pw_uid
    except KeyError as error:
        raise RequestError(f"Configured {'group' if group else 'user'} does not exist: {name}") from error


def target_metadata(config: dict, target_id: str, current: os.stat_result | None) -> tuple[int, int, int]:
    if current is not None:
        return current.st_uid, current.st_gid, stat.S_IMODE(current.st_mode)
    defaults = config["file_defaults"].get(target_id)
    if not isinstance(defaults, dict):
        raise RequestError(f"No creation metadata configured for {target_id}.")
    try:
        mode = int(str(defaults["mode"]), 8)
        return identity(defaults["owner"]), identity(defaults["group"], True), mode
    except (KeyError, ValueError) as error:
        raise RequestError(f"Invalid creation metadata for {target_id}.") from error


def write_all(descriptor: int, content: bytes) -> None:
    offset = 0
    while offset < len(content):
        offset += os.write(descriptor, content[offset:])


def atomic_write(config: dict, target_id: str, content: str) -> None:
    if target_id not in config["files"]:
        raise RequestError("Unknown managed file.")
    encoded = content.encode("utf-8")
    if len(encoded) > MAX_FILE_BYTES or b"\x00" in encoded:
        raise RequestError("Managed file content is invalid or too large.")

    target = str(config["files"][target_id])
    directory, filename = os.path.split(target)
    directory_fd = secure_directory(directory)
    try:
        current = secure_regular_file(target, required=False)
        uid, gid, mode = target_metadata(config, target_id, current)
        temporary = f".mxcentral-{filename}-{secrets.token_hex(12)}.tmp"
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_fd,
        )
        try:
            write_all(descriptor, encoded)
            os.fchmod(descriptor, mode)
            os.fchown(descriptor, uid, gid)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)

        if target_id == "iredapd_settings":
            try:
                ast.parse(content)
            except SyntaxError as error:
                os.unlink(temporary, dir_fd=directory_fd)
                raise RequestError(f"iRedAPD settings validation failed: {error}")
        if target_id == "sogo_template":
            try:
                ET.fromstring(content)
            except ET.ParseError as error:
                os.unlink(temporary, dir_fd=directory_fd)
                raise RequestError(f"SOGo template XML validation failed: {error}") from error

        if current is not None:
            backup_content = read_nofollow(target)
            atomic_backup(config, target_id, target + ".bak", backup_content, current)

        os.replace(temporary, filename, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def without_marker_block(content: str, begin: str, end: str) -> str:
    return re.sub(
        re.escape(begin) + r".*?" + re.escape(end) + r"(?:\r?\n)?",
        "",
        content,
        count=1,
        flags=re.DOTALL,
    )


def canonical_iredapd(content: str) -> str:
    content = without_marker_block(
        content,
        "# BEGIN iredadmin-php managed: login mismatch senders",
        "# END iredadmin-php managed: login mismatch senders",
    )
    content = without_marker_block(
        content,
        "# BEGIN mxcentral managed: unauthenticated senders",
        "# END mxcentral managed: unauthenticated senders",
    )

    def normalize_plugins(match: re.Match) -> str:
        try:
            plugins = ast.literal_eval("[" + match.group(1) + "]")
        except (SyntaxError, ValueError) as error:
            raise RequestError(f"Cannot validate iRedAPD plugins: {error}") from error
        if not isinstance(plugins, list) or not all(isinstance(item, str) for item in plugins):
            raise RequestError("iRedAPD plugins must be a string list.")
        plugins = [item for item in plugins if item != "reject_sender_login_mismatch"]
        return "" if not plugins else "plugins = " + repr(plugins)

    return re.sub(
        r"^[ \t]*plugins[ \t]*=[ \t]*\[(.*?)\][ \t]*(?:#[^\r\n]*)?(?:\r?\n)?",
        normalize_plugins,
        content,
        count=1,
        flags=re.MULTILINE | re.DOTALL,
    )


def canonical_postfix(config: dict, content: str) -> str:
    for value in (
        "check_sender_access pcre:" + str(config["files"]["postfix_sender_access"]),
        "check_recipient_access hash:" + str(config["files"]["postfix_discard_recipients"]),
        "check_recipient_access pcre:" + str(config["files"]["postfix_staging_domains"]),
    ):
        content = content.replace(value, "")
    content = re.sub(r"\breject_sender_login_mismatch\b", "", content)
    content = re.sub(r"\s*,\s*", ",", content)
    content = re.sub(r",+", ",", content)
    return re.sub(r"\s+", " ", content).strip()


def canonical_sogo(content: str) -> str:
    content = without_marker_block(
        content,
        "<!-- BEGIN MXCentral managed SOGo login branding -->",
        "<!-- END MXCentral managed SOGo login branding -->",
    )
    content = re.sub(
        r"<style\b[^>]*>(?=[\s\S]*?\.md-default-theme\.md-accent\.md-bg\s*\{)(?=[\s\S]*?#login\s+\*\s*\{)[\s\S]*?</style>",
        "",
        content,
        count=1,
        flags=re.IGNORECASE,
    )
    preferred = re.compile(r"<img\b(?=[^>]*\bclass=([\"'])[^\"']*\bmd-margin\b[^\"']*\1)[^>]*>", re.IGNORECASE | re.DOTALL)
    generic = re.compile(r"<img\b[^>]*>", re.IGNORECASE | re.DOTALL)
    image_pattern = preferred if preferred.search(content) else generic

    def normalize_image(match: re.Match) -> str:
        tag = re.sub(r"(?<![:\w-])src=([\"']).*?\1", 'src="__MXCENTRAL_LOGO__"', match.group(0), count=1, flags=re.IGNORECASE | re.DOTALL)
        tag = re.sub(r"\brsrc:src=([\"']).*?\1", 'src="__MXCENTRAL_LOGO__"', tag, count=1, flags=re.IGNORECASE | re.DOTALL)
        if "__MXCENTRAL_LOGO__" not in tag:
            tag = tag.rstrip(">") + ' src="__MXCENTRAL_LOGO__">'
        return tag

    content = image_pattern.sub(normalize_image, content, count=1)
    return re.sub(
        r"(</script\s*>)\s*(<!--\s*MAIN CONTENT ROW)",
        r"\1\n\2",
        content,
        count=1,
        flags=re.IGNORECASE,
    )


def validate_managed_change(config: dict, target_id: str, current: str, candidate: str) -> None:
    if target_id == "amavis_config":
        if without_marker_block(current, "# BEGIN mxcentral-for-iRedmail managed DKIM keys", "# END mxcentral-for-iRedmail managed DKIM keys") != without_marker_block(candidate, "# BEGIN mxcentral-for-iRedmail managed DKIM keys", "# END mxcentral-for-iRedmail managed DKIM keys"):
            raise RequestError("Refusing an Amavis change outside the MXCentral DKIM block.")
        validate_amavis_dkim_block(config, candidate)
        return
    if target_id == "iredapd_settings":
        if canonical_iredapd(current) != canonical_iredapd(candidate):
            raise RequestError("Refusing an iRedAPD change outside approved MXCentral settings.")
        validate_iredapd_managed_blocks(candidate)
        return
    if target_id == "postfix_main":
        if canonical_postfix(config, current) != canonical_postfix(config, candidate):
            raise RequestError("Refusing a Postfix change outside approved access hooks.")
        return
    if target_id == "postfix_sender_access":
        outside = lambda value: without_marker_block(value, "# BEGIN mxcentral managed: unauthenticated senders", "# END mxcentral managed: unauthenticated senders")
        if outside(current) != outside(candidate):
            raise RequestError("Refusing a sender-access change outside the MXCentral block.")
        block_match = re.search(
            re.escape("# BEGIN mxcentral managed: unauthenticated senders")
            + r"(.*?)"
            + re.escape("# END mxcentral managed: unauthenticated senders"),
            candidate,
            flags=re.DOTALL,
        )
        block = "" if block_match is None else block_match.group(1)
        for line in block.splitlines():
            stripped = line.strip()
            if stripped and not stripped.startswith("#") and not (stripped.startswith("/") and stripped.endswith(" OK")):
                raise RequestError("Sender-access rules may only return OK.")
        return
    if target_id == "postfix_discard_recipients":
        for line in candidate.splitlines():
            stripped = line.strip()
            if stripped and not stripped.startswith("#"):
                parts = stripped.split()
                if len(parts) != 2 or not EMAIL_PATTERN.fullmatch(parts[0]) or parts[1] != "DISCARD":
                    raise RequestError("Invalid managed discard-recipient rule.")
        return
    if target_id == "postfix_staging_domains":
        for line in candidate.splitlines():
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            suffix = " 450 4.2.0 Domain migration in progress; please try again later"
            rule = stripped[: -len(suffix)] if stripped.endswith(suffix) else ""
            encoded_domain = rule[2:-3] if rule.startswith("/@") and rule.endswith("$/i") else ""
            domain = encoded_domain.replace("\\.", ".")
            if re.fullmatch(r"[a-z0-9.\\-]+", encoded_domain, flags=re.IGNORECASE) is None:
                domain = ""
            if not DOMAIN_PATTERN.fullmatch(domain):
                raise RequestError("Invalid managed staging-domain rule.")
        return
    if target_id == "sogo_template":
        if canonical_sogo(current) != canonical_sogo(candidate):
            raise RequestError("Refusing a SOGo change outside logo and login branding.")
        validate_sogo_branding(candidate)
        return
    raise RequestError("No managed-change policy exists for target.")


def validate_iredapd_managed_blocks(content: str) -> None:
    policies = (
        (
            "# BEGIN iredadmin-php managed: login mismatch senders",
            "# END iredadmin-php managed: login mismatch senders",
            {"ALLOWED_LOGIN_MISMATCH_SENDERS"},
        ),
        (
            "# BEGIN mxcentral managed: unauthenticated senders",
            "# END mxcentral managed: unauthenticated senders",
            {"ALLOWED_FORGED_SENDERS", "MYNETWORKS"},
        ),
    )
    for begin, end, allowed_names in policies:
        match = re.search(re.escape(begin) + r"(.*?)" + re.escape(end), content, flags=re.DOTALL)
        if match is None:
            continue
        body = "\n".join(
            line for line in match.group(1).splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        )
        try:
            tree = ast.parse(body)
        except SyntaxError as error:
            raise RequestError(f"Invalid managed iRedAPD block: {error}") from error
        assigned = set()
        for statement in tree.body:
            if not isinstance(statement, ast.Assign) or len(statement.targets) != 1 or not isinstance(statement.targets[0], ast.Name):
                raise RequestError("Managed iRedAPD blocks may contain only approved list assignments.")
            name = statement.targets[0].id
            if name not in allowed_names or name in assigned:
                raise RequestError("Managed iRedAPD block contains an unapproved assignment.")
            try:
                value = ast.literal_eval(statement.value)
            except (ValueError, TypeError) as error:
                raise RequestError("Managed iRedAPD values must be literal string lists.") from error
            if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
                raise RequestError("Managed iRedAPD values must be literal string lists.")
            assigned.add(name)
        if assigned != allowed_names:
            raise RequestError("Managed iRedAPD block is missing an approved assignment.")


def validate_amavis_dkim_block(config: dict, content: str) -> None:
    begin = "# BEGIN mxcentral-for-iRedmail managed DKIM keys"
    end = "# END mxcentral-for-iRedmail managed DKIM keys"
    match = re.search(re.escape(begin) + r"(.*?)" + re.escape(end), content, flags=re.DOTALL)
    if match is None:
        return
    key_domains = set()
    map_domains = set()
    push_count = 0
    close_count = 0
    selector = re.escape(str(config["dkim"].get("selector", "mxcentral")))
    directory = re.escape(str(config["dkim"]["directory"]).rstrip("/"))
    key_pattern = re.compile(
        rf"dkim_key\('({DOMAIN_PATTERN.pattern[:-2]})', '{selector}', '{directory}/\1\.pem'\);"
    )
    map_pattern = re.compile(
        rf"'({DOMAIN_PATTERN.pattern[:-2]})' => \{{ d => '\1', a => 'rsa-sha256', ttl => 10\*24\*3600 \}},"
    )
    for line in match.group(1).splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        key_match = key_pattern.fullmatch(stripped)
        if key_match is not None:
            key_domains.add(key_match.group(1))
            continue
        map_match = map_pattern.fullmatch(stripped)
        if map_match is not None:
            map_domains.add(map_match.group(1))
            continue
        if stripped == "push @dkim_signature_options_bysender_maps, {":
            push_count += 1
            continue
        if stripped == "};":
            close_count += 1
            continue
        raise RequestError("Amavis DKIM block contains an unapproved statement.")
    if key_domains != map_domains or push_count != 1 or close_count != 1:
        raise RequestError("Amavis DKIM key and sender-map domains do not match.")


def validate_sogo_branding(content: str) -> None:
    begin = "<!-- BEGIN MXCentral managed SOGo login branding -->"
    end = "<!-- END MXCentral managed SOGo login branding -->"
    match = re.search(re.escape(begin) + r"(.*?)" + re.escape(end), content, flags=re.DOTALL)
    if match is None:
        raise RequestError("The managed SOGo branding block is missing.")
    expected = re.compile(
        r"\s*<style type=\"text/css\">\s*"
        r"\.md-default-theme\.md-accent\.md-bg\s*\{\s*"
        r"background-color:\s*#[0-9a-fA-F]{6}\s*!important;\s*\}\s*"
        r"#login\s+\*\s*\{\s*color:\s*#[0-9a-fA-F]{6}\s*!important;\s*\}\s*"
        r"</style>\s*"
    )
    if expected.fullmatch(match.group(1)) is None:
        raise RequestError("The managed SOGo branding block contains unapproved markup or CSS.")
    preferred = re.search(r"<img\b(?=[^>]*\bclass=([\"'])[^\"']*\bmd-margin\b[^\"']*\1)[^>]*>", content, flags=re.IGNORECASE | re.DOTALL)
    image = preferred or re.search(r"<img\b[^>]*>", content, flags=re.IGNORECASE | re.DOTALL)
    if image is None:
        raise RequestError("The SOGo login image is missing.")
    source = re.search(r"(?<![:\w-])src=([\"'])(.*?)\1", image.group(0), flags=re.IGNORECASE | re.DOTALL)
    if source is None:
        raise RequestError("The SOGo login image source is missing.")
    parsed = urllib.parse.urlparse(html.unescape(source.group(2)))
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        raise RequestError("The SOGo logo URL must use http or https.")


def redact_managed_read(target_id: str, content: str) -> str:
    if target_id != "iredapd_settings":
        return content
    content = re.sub(
        r"^([ \t]*[A-Za-z0-9_]*(?:PASSWORD|PASSWD|SECRET|TOKEN|API_KEY)[A-Za-z0-9_]*[ \t]*=[ \t]*).*$",
        r"\1'<MXCENTRAL_REDACTED>'",
        content,
        flags=re.MULTILINE | re.IGNORECASE,
    )
    return re.sub(
        r"(([\"']?)(?:password|passwd|secret|token|api_key)\2[ \t]*:[ \t]*)([\"']).*?\3",
        r"\1\3<MXCENTRAL_REDACTED>\3",
        content,
        flags=re.IGNORECASE,
    )


def restore_redacted_iredapd(current: str, candidate: str) -> str:
    assignments = {}
    pattern = re.compile(
        r"^([ \t]*([A-Za-z0-9_]*(?:PASSWORD|PASSWD|SECRET|TOKEN|API_KEY)[A-Za-z0-9_]*)[ \t]*=[ \t]*).*$",
        flags=re.MULTILINE | re.IGNORECASE,
    )
    for match in pattern.finditer(current):
        assignments[match.group(2).lower()] = match.group(0)

    def restore_assignment(match: re.Match) -> str:
        return assignments.get(match.group(2).lower(), match.group(0))

    candidate = pattern.sub(restore_assignment, candidate)
    for field in ("password", "passwd", "secret", "token", "api_key"):
        current_match = re.search(
            rf"(([\"']?){field}\2[ \t]*:[ \t]*)([\"']).*?\3",
            current,
            flags=re.IGNORECASE,
        )
        if current_match is not None:
            candidate = re.sub(
                rf"(([\"']?){field}\2[ \t]*:[ \t]*)([\"'])<MXCENTRAL_REDACTED>\3",
                lambda _: current_match.group(0),
                candidate,
                count=1,
                flags=re.IGNORECASE,
            )
    return candidate


def atomic_backup(config: dict, target_id: str, path: str, content: bytes, metadata: os.stat_result) -> None:
    directory, filename = os.path.split(path)
    directory_fd = secure_directory(directory)
    try:
        temporary = f".mxcentral-{filename}-{secrets.token_hex(12)}.tmp"
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_fd,
        )
        try:
            write_all(descriptor, content)
            os.fchmod(descriptor, stat.S_IMODE(metadata.st_mode))
            os.fchown(descriptor, metadata.st_uid, metadata.st_gid)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(temporary, filename, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def read_nofollow(path: str) -> bytes:
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        chunks = []
        while True:
            chunk = os.read(descriptor, 65536)
            if not chunk:
                return b"".join(chunks)
            chunks.append(chunk)
    finally:
        os.close(descriptor)


def valid_domain(value: object) -> str:
    domain = str(value).strip().lower()
    if not DOMAIN_PATTERN.fullmatch(domain):
        raise RequestError("Invalid DKIM domain.")
    return domain


def run_command(config: dict, command_id: str, extra: list[str] | None = None) -> dict:
    command = config["commands"].get(command_id)
    if not isinstance(command, list) or not command or not all(isinstance(item, str) for item in command):
        raise RequestError(f"Command is not configured: {command_id}")
    result = subprocess.run(
        command + (extra or []),
        capture_output=True,
        text=True,
        timeout=60,
        check=False,
        env=SAFE_COMMAND_ENV,
    )
    message = (result.stdout + "\n" + result.stderr).strip()
    if result.returncode != 0:
        raise RequestError(message or f"{command_id} failed with status {result.returncode}.")
    return {"message": message, "output": result.stdout}


def operation_state_directory(config: dict) -> str:
    path = str(config.get("operation_state_directory", ""))
    if not os.path.isabs(path):
        raise RequestError("The operation state directory must be absolute.")
    parent = os.path.dirname(path)
    parent_fd = secure_directory(parent)
    try:
        try:
            os.mkdir(os.path.basename(path), 0o750, dir_fd=parent_fd)
        except FileExistsError:
            pass
    finally:
        os.close(parent_fd)
    directory_fd = secure_directory(path)
    os.close(directory_fd)
    return path


def write_operation_state(config: dict, operation_id: str, status_value: str, message: str, targets: list[str]) -> None:
    directory = operation_state_directory(config)
    directory_fd = secure_directory(directory)
    filename = f"{operation_id}.json"
    temporary = f".{filename}-{secrets.token_hex(8)}.tmp"
    content = json.dumps(
        {
            "operation_id": operation_id,
            "status": status_value,
            "message": message,
            "targets": targets,
            "updated_at": int(time.time()),
        },
        sort_keys=True,
    ).encode("utf-8")
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_fd,
        )
        try:
            write_all(descriptor, content)
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        os.replace(temporary, filename, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        os.fsync(directory_fd)
    finally:
        try:
            os.unlink(temporary, dir_fd=directory_fd)
        except FileNotFoundError:
            pass
        os.close(directory_fd)


def run_configuration_command(config: dict, specification: object) -> dict:
    if isinstance(specification, str):
        if specification not in {
            "amavis_restart",
            "iredapd_restart",
            "postfix_check",
            "postfix_reload",
            "sogo_reload",
        }:
            raise RequestError("Invalid configuration command.")
        return run_command(config, specification)
    if isinstance(specification, dict) and specification.get("command") == "postmap":
        target_id = str(specification.get("target", ""))
        if target_id != "postfix_discard_recipients":
            raise RequestError("Invalid postmap target.")
        return run_command(config, "postmap", [str(config["files"][target_id])])
    raise RequestError("Invalid configuration command specification.")


def apply_configuration(config: dict, parameters: dict) -> dict:
    writes = parameters.get("writes", {})
    commands = parameters.get("commands", [])
    if not isinstance(writes, dict) or not isinstance(commands, list) or (not writes and not commands):
        raise RequestError("Configuration transaction requires writes and a command list.")
    if len(writes) > len(config["files"]):
        raise RequestError("Too many managed files in one transaction.")

    normalized: dict[str, str] = {}
    snapshots: dict[str, bytes | None] = {}
    for target_id, content in writes.items():
        if target_id not in config["files"] or not isinstance(content, str):
            raise RequestError("Unknown managed file or invalid content.")
        normalized[target_id] = content
        target = str(config["files"][target_id])
        current = secure_regular_file(target, required=False)
        snapshots[target_id] = None if current is None else read_nofollow(target)
        baseline = "" if snapshots[target_id] is None else snapshots[target_id].decode("utf-8")
        if snapshots[target_id] is None and target_id == "sogo_template":
            source = str(config.get("file_sources", {}).get(target_id, ""))
            secure_regular_file(source)
            baseline = read_nofollow(source).decode("utf-8")
        if target_id == "iredapd_settings":
            content = restore_redacted_iredapd(baseline, content)
            normalized[target_id] = content
        validate_managed_change(config, target_id, baseline, content)

    # Validate the full command plan before changing any file.
    for command in commands:
        if isinstance(command, str):
            if command not in {"amavis_restart", "iredapd_restart", "postfix_check", "postfix_reload", "sogo_reload"}:
                raise RequestError("Invalid configuration command.")
        elif not (
            isinstance(command, dict)
            and command.get("command") == "postmap"
            and command.get("target") == "postfix_discard_recipients"
        ):
            raise RequestError("Invalid configuration command specification.")

    operation_id = secrets.token_hex(16)
    targets = sorted(normalized)
    write_operation_state(config, operation_id, "pending", "Configuration transaction is pending.", targets)
    changed: list[str] = []
    try:
        for target_id, content in normalized.items():
            atomic_write(config, target_id, content)
            changed.append(target_id)
        results = [run_configuration_command(config, command) for command in commands]
        write_operation_state(config, operation_id, "applied", "Configuration transaction applied.", targets)
        return {"operation_id": operation_id, "status": "applied", "commands": results}
    except Exception as error:
        rollback_errors = []
        for target_id in reversed(changed):
            try:
                previous = snapshots[target_id]
                if previous is None:
                    target = str(config["files"][target_id])
                    directory_fd = secure_directory(os.path.dirname(target))
                    try:
                        os.unlink(os.path.basename(target), dir_fd=directory_fd)
                        os.fsync(directory_fd)
                    finally:
                        os.close(directory_fd)
                else:
                    atomic_write(config, target_id, previous.decode("utf-8"))
            except Exception as rollback_error:
                rollback_errors.append(str(rollback_error))
        # Re-run service validation/reload against restored files where possible.
        for command in commands:
            try:
                run_configuration_command(config, command)
            except Exception as rollback_command_error:
                rollback_errors.append(str(rollback_command_error))
        message = str(error)
        if rollback_errors:
            message += " Rollback errors: " + "; ".join(rollback_errors)
        write_operation_state(config, operation_id, "failed", message, targets)
        raise RequestError(f"Configuration transaction {operation_id} failed: {message}") from error


def generate_dkim(config: dict, parameters: dict) -> dict:
    domain = valid_domain(parameters.get("domain", ""))
    bits = int(parameters.get("bits", 0))
    if bits not in (1024, 2048):
        raise RequestError("DKIM key size must be 1024 or 2048.")

    settings = config["dkim"]
    directory = str(settings["directory"])
    directory_fd = secure_directory(directory)
    filename = f"{domain}.pem"
    temporary = f".mxcentral-{domain}-{secrets.token_hex(12)}.tmp"
    try:
        existing = secure_regular_file(os.path.join(directory, filename), required=False)
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_fd,
        )
        os.close(descriptor)
        command = settings.get("genrsa")
        if not isinstance(command, list) or not command:
            raise RequestError("DKIM generation command is not configured.")
        result = subprocess.run(
            command + [os.path.join(directory, temporary), str(bits)],
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
            env=SAFE_COMMAND_ENV,
        )
        if result.returncode != 0:
            os.unlink(temporary, dir_fd=directory_fd)
            raise RequestError((result.stdout + "\n" + result.stderr).strip() or "DKIM generation failed.")
        generated = secure_regular_file(os.path.join(directory, temporary))
        if generated is None or generated.st_size == 0:
            os.unlink(temporary, dir_fd=directory_fd)
            raise RequestError("DKIM generator did not produce a regular non-empty key.")
        descriptor = os.open(temporary, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory_fd)
        try:
            os.fchmod(descriptor, int(str(settings["mode"]), 8))
            os.fchown(descriptor, identity(settings["owner"]), identity(settings["group"], True))
            os.fsync(descriptor)
        finally:
            os.close(descriptor)
        if existing is not None:
            previous = (
                f"{os.path.join(directory, filename)}.previous-"
                f"{time.strftime('%Y%m%d%H%M%S', time.gmtime())}-{secrets.token_hex(4)}"
            )
            atomic_backup(config, "amavis_config", previous, read_nofollow(os.path.join(directory, filename)), existing)
        os.replace(temporary, filename, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        os.fsync(directory_fd)
        return {"rotated": existing is not None, "path": os.path.join(directory, filename)}
    finally:
        try:
            os.unlink(temporary, dir_fd=directory_fd)
        except FileNotFoundError:
            pass
        os.close(directory_fd)


def delete_dkim(config: dict, parameters: dict) -> dict:
    domain = valid_domain(parameters.get("domain", ""))
    directory = str(config["dkim"]["directory"])
    directory_fd = secure_directory(directory)
    deleted = []
    try:
        for name in os.listdir(directory_fd):
            if name != f"{domain}.pem" and not name.startswith(f"{domain}.pem.previous-"):
                continue
            info = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            if not stat.S_ISREG(info.st_mode):
                raise RequestError(f"Refusing non-regular DKIM entry: {name}")
            os.unlink(name, dir_fd=directory_fd)
            deleted.append(os.path.join(directory, name))
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
    return {"deleted": deleted}


def dkim_status(config: dict, parameters: dict) -> dict:
    domain = valid_domain(parameters.get("domain", ""))
    path = os.path.join(str(config["dkim"]["directory"]), f"{domain}.pem")
    directory_fd = secure_directory(os.path.dirname(path))
    try:
        info = secure_regular_file(path, required=False)
        return {
            "exists": info is not None,
            "path": path,
            "mode": None if info is None else format(stat.S_IMODE(info.st_mode), "04o"),
        }
    finally:
        os.close(directory_fd)


def dkim_entries(config: dict, domain: str) -> dict[str, tuple[bytes, int, int, int]]:
    directory = str(config["dkim"]["directory"])
    directory_fd = secure_directory(directory)
    entries = {}
    try:
        for name in os.listdir(directory_fd):
            if name != f"{domain}.pem" and not name.startswith(f"{domain}.pem.previous-"):
                continue
            path = os.path.join(directory, name)
            info = secure_regular_file(path)
            if info is None:
                continue
            entries[name] = (
                read_nofollow(path),
                info.st_uid,
                info.st_gid,
                stat.S_IMODE(info.st_mode),
            )
    finally:
        os.close(directory_fd)
    return entries


def restore_dkim_entries(config: dict, domain: str, entries: dict[str, tuple[bytes, int, int, int]]) -> None:
    delete_dkim(config, {"domain": domain})
    directory = str(config["dkim"]["directory"])
    directory_fd = secure_directory(directory)
    try:
        for name, (content, uid, gid, mode) in entries.items():
            temporary = f".mxcentral-restore-{secrets.token_hex(12)}.tmp"
            descriptor = os.open(
                temporary,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                0o600,
                dir_fd=directory_fd,
            )
            try:
                write_all(descriptor, content)
                os.fchmod(descriptor, mode)
                os.fchown(descriptor, uid, gid)
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
            os.replace(temporary, name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def apply_dkim_configuration(config: dict, parameters: dict) -> dict:
    domain = valid_domain(parameters.get("domain", ""))
    action = str(parameters.get("action", ""))
    content = parameters.get("amavis_content")
    if action not in {"generate", "delete"} or not isinstance(content, str):
        raise RequestError("Invalid DKIM transaction.")
    bits = int(parameters.get("bits", 0)) if action == "generate" else 0
    if action == "generate" and bits not in (1024, 2048):
        raise RequestError("DKIM key size must be 1024 or 2048.")

    amavis_path = str(config["files"]["amavis_config"])
    amavis_info = secure_regular_file(amavis_path, required=False)
    amavis_snapshot = None if amavis_info is None else read_nofollow(amavis_path)
    validate_managed_change(
        config,
        "amavis_config",
        "" if amavis_snapshot is None else amavis_snapshot.decode("utf-8"),
        content,
    )
    key_snapshots = dkim_entries(config, domain)
    operation_id = secrets.token_hex(16)
    write_operation_state(config, operation_id, "pending", "DKIM transaction is pending.", ["amavis_config", domain])
    try:
        key_result = (
            generate_dkim(config, {"domain": domain, "bits": bits})
            if action == "generate"
            else delete_dkim(config, {"domain": domain})
        )
        atomic_write(config, "amavis_config", content)
        restart = run_command(config, "amavis_restart")
        write_operation_state(config, operation_id, "applied", "DKIM transaction applied.", ["amavis_config", domain])
        return {
            "operation_id": operation_id,
            "status": "applied",
            "key": key_result,
            "restart": restart,
        }
    except Exception as error:
        rollback_errors = []
        try:
            restore_dkim_entries(config, domain, key_snapshots)
        except Exception as rollback_error:
            rollback_errors.append(str(rollback_error))
        try:
            if amavis_snapshot is not None:
                atomic_write(config, "amavis_config", amavis_snapshot.decode("utf-8"))
        except Exception as rollback_error:
            rollback_errors.append(str(rollback_error))
        try:
            run_command(config, "amavis_restart")
        except Exception as rollback_error:
            rollback_errors.append(str(rollback_error))
        message = str(error)
        if rollback_errors:
            message += " Rollback errors: " + "; ".join(rollback_errors)
        write_operation_state(config, operation_id, "failed", message, ["amavis_config", domain])
        raise RequestError(f"DKIM transaction {operation_id} failed: {message}") from error


def health_check(config: dict) -> dict:
    required_files = {"amavis_config", "iredapd_settings", "postfix_main"}
    checked_files = []
    for target_id, target_value in config["files"].items():
        target = str(target_value)
        directory_fd = secure_directory(os.path.dirname(target))
        os.close(directory_fd)
        if target_id in required_files:
            secure_regular_file(target)
        else:
            secure_regular_file(target, required=False)
        checked_files.append(target_id)
    for source in config.get("file_sources", {}).values():
        secure_regular_file(str(source))
    directory_fd = secure_directory(str(config["dkim"]["directory"]))
    os.close(directory_fd)
    operation_state_directory(config)
    for command_id, command in config["commands"].items():
        if not isinstance(command, list) or not command or not all(isinstance(item, str) for item in command):
            raise RequestError(f"Invalid command configuration: {command_id}")
        executable = command[0]
        if not os.path.isabs(executable):
            raise RequestError(f"Configured command is not executable: {command_id}")
        directory_fd = secure_directory(os.path.dirname(executable))
        os.close(directory_fd)
        info = secure_regular_file(executable)
        if info is None or info.st_uid != 0 or info.st_mode & 0o022 or not os.access(executable, os.X_OK):
            raise RequestError(f"Configured command is not a secure root-owned executable: {command_id}")
    return {"files": sorted(checked_files), "status": "healthy"}


def dispatch(config: dict, request: dict) -> dict:
    operation = request.get("operation")
    parameters = request.get("parameters", {})
    if not isinstance(parameters, dict):
        raise RequestError("Parameters must be an object.")
    if operation == "apply_configuration":
        return apply_configuration(config, parameters)
    if operation == "read_file":
        target_id = str(parameters.get("target", ""))
        if target_id not in config["files"]:
            raise RequestError("Unknown managed file.")
        path = str(config["files"][target_id])
        directory_fd = secure_directory(os.path.dirname(path))
        os.close(directory_fd)
        secure_regular_file(path)
        content = read_nofollow(path)
        if len(content) > MAX_FILE_BYTES:
            raise RequestError("Managed file is too large.")
        return {"content": redact_managed_read(target_id, content.decode("utf-8"))}
    if operation == "health_check":
        return health_check(config)
    if operation == "dkim_status":
        return dkim_status(config, parameters)
    if operation == "dkim_apply":
        return apply_dkim_configuration(config, parameters)
    if operation in {"amavis_showkeys", "amavis_testkeys"}:
        return run_command(config, operation)
    if operation == "fail2ban_unban":
        address = str(parameters.get("ip", ""))
        import ipaddress

        try:
            address = str(ipaddress.ip_address(address))
        except ValueError as error:
            raise RequestError("Invalid IP address.") from error
        return run_command(config, "fail2ban_unban", [address])
    raise RequestError("Unknown privileged operation.")


def main() -> int:
    global ACTIVE_CONFIG
    if len(sys.argv) != 1:
        print(json.dumps({"ok": False, "message": "Command-line arguments are not accepted.", "data": {}}))
        return 64
    raw = sys.stdin.buffer.read(MAX_REQUEST_BYTES + 1)
    if len(raw) > MAX_REQUEST_BYTES:
        print(json.dumps({"ok": False, "message": "Request is too large.", "data": {}}))
        return 65
    try:
        request = json.loads(raw.decode("utf-8"))
        if not isinstance(request, dict):
            raise RequestError("Request must be an object.")
        config = read_secure_config()
        ACTIVE_CONFIG = config
        lock_descriptor = os.open(LOCK_PATH, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        try:
            fcntl.flock(lock_descriptor, fcntl.LOCK_EX)
            data = dispatch(config, request)
        finally:
            os.close(lock_descriptor)
        print(json.dumps({"ok": True, "message": "Privileged operation completed.", "data": data}))
        return 0
    except (RequestError, ValueError, TypeError, KeyError, OSError, subprocess.SubprocessError) as error:
        print(json.dumps({"ok": False, "message": str(error), "data": {}}))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
